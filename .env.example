# Copy to .env and adjust. Never commit .env (it may hold keys).
#
# CollectionSpace to talk to. The default is the simulated CollectionSpace in docker compose.
# For the Lyrasis QA tenant use: BMU_CSPACE_URL=https://pahma.qa.collectionspace.org
BMU_CSPACE_URL=http://fakecspace:8180

# Keys that encrypt passwords at rest in local development (32 random bytes, base64):
#   python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
BMU_SESSION_KEY_B64=
BMU_JOB_KEY_B64=

# Job scheduling (design: Job scheduling): queued jobs start at the tenant's run time (default 7:00 PM Pacific).
# For quick local click-throughs, make every moment a run time. Staff can also use "Run now".
# BMU_ALWAYS_RUN_TIME=true
