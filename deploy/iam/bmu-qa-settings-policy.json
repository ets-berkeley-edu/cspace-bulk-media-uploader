{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadMetadata",
      "Effect": "Allow",
      "Action": [
        "ssm:DescribeParameters"
      ],
      "Resource": "*"
    },
    {
      "Sid": "QaSettings",
      "Effect": "Allow",
      "Action": [
        "ssm:AddTagsToResource",
        "ssm:DeleteParameter",
        "ssm:GetParameters",
        "ssm:PutParameter"
      ],
      "Resource": [
        "arn:aws:ssm:us-west-2:*:parameter/bmu-qa/settings/*"
      ]
    },
    {
      "Sid": "NotTheAccountCheck",
      "Effect": "Deny",
      "Action": [
        "ssm:AddTagsToResource",
        "ssm:DeleteParameter",
        "ssm:PutParameter"
      ],
      "Resource": [
        "arn:aws:ssm:*:*:parameter/bmu-qa/settings/REAL_DATA_ACCOUNT"
      ]
    }
  ]
}
