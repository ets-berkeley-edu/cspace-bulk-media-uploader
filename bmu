#!/usr/bin/env bash
# ./bmu — start, stop and open the BMU's environments, side by side.
#
#   ./bmu up sim        local stack with the simulated CollectionSpace and Demo tools  → http://localhost:5173
#   ./bmu up qa         local stack against a QA tenant, PAHMA's unless BMU_QA_TENANT (real records!) → http://localhost:5273
#   ./bmu down sim|qa|all
#   ./bmu status        which environments are running, and their addresses
#   ./bmu logs sim|qa [service]     follow the logs (services: web, worker, frontend, fakecspace, s3, dynamodb)
#   ./bmu open sim|qa|aws|mockup|home
#   ./bmu urls          every address, including the UI mockup and AWS
#   ./bmu aws ...       deploy to AWS and look after it: ./bmu aws help (deploy/README.md)
#   ./bmu test [pytest options]   the Selenium tests (bmut/) on their own stack, started afresh; --headed shows Chrome
#   ./bmu test-down     stop the test stack
#
# Each local environment is its own Docker Compose project (bmu-sim, bmu-qa, bmu-test) with its own ports, data,
# environment label (shown in the app's header) and session cookie, so they can run at once without signing each other
# out. sim and qa need .env with BMU_SESSION_KEY_B64 and BMU_JOB_KEY_B64 (see README, Run it locally); the test stack
# makes its own keys each run. Nothing here holds a password: in the QA environment you sign in with your own QA
# account, in the browser.
set -euo pipefail
cd "$(dirname "$0")"

# ---- the environments ------------------------------------------------------------------------------------------
# The QA tenant for ./bmu up qa: PAHMA unless BMU_QA_TENANT names another museum with a configuration
# (backend/bmu/tenants/<museum>.yaml), such as ucjeps; its server is https://<museum>.qa.collectionspace.org.
QA_TENANT="${BMU_QA_TENANT:-pahma}"
QA_CSPACE_URL="${BMU_QA_CSPACE_URL:-https://$QA_TENANT.qa.collectionspace.org}"
# The AWS environment's address: saved by ./bmu aws deploy (BMU_AWS_ENV picks the environment; BMU_AWS_DEV_URL overrides)
AWS_ENV="${BMU_AWS_ENV:-personal-dev}"
AWS_DEV_URL="${BMU_AWS_DEV_URL:-$(cat "deploy/environments/$AWS_ENV.url" 2>/dev/null || true)}"
MOCKUP_FILE="docs/mockup/bmu-mockup.html"

# Sets the variables docker-compose.yml reads, for one local environment.
env_settings() {
  case "$1" in
    sim)
      export BMU_UI_PORT=5173 BMU_API_PORT=8000 BMU_S3_PORT=9000 BMU_DYNAMODB_PORT=8001 BMU_SIM_PORT=8180
      export BMU_CSPACE_URL="http://fakecspace:8180" BMU_TENANT=pahma BMU_DEMO=true BMU_COOKIE_NAME=bmu_session
      export BMU_ENV_LABEL="Local · simulated CollectionSpace"
      export BMU_READER_USER=bmureader BMU_READER_PASSWORD=bmureader   # the simulator's read-only account, for interns' checks
      export BMU_ALWAYS_RUN_TIME="${BMU_ALWAYS_RUN_TIME:-false}" ;;
    qa)
      export BMU_UI_PORT=5273 BMU_API_PORT=8100 BMU_S3_PORT=9100 BMU_DYNAMODB_PORT=8101 BMU_SIM_PORT=8280
      [ -f "backend/bmu/tenants/$QA_TENANT.yaml" ] ||
        { echo "BMU_QA_TENANT=$QA_TENANT: the BMU has no configuration for it (backend/bmu/tenants/$QA_TENANT.yaml)." >&2; exit 2; }
      export BMU_CSPACE_URL="$QA_CSPACE_URL" BMU_TENANT="$QA_TENANT" BMU_DEMO=false BMU_COOKIE_NAME=bmu_session_qa
      BMU_ENV_LABEL="Local · $(echo "$QA_TENANT" | tr '[:lower:]' '[:upper:]') QA"; export BMU_ENV_LABEL
      # QA's read-only account for interns' checks, if you have one: set both in your shell, never in a file here.
      # Without them an intern's documents are checked with the intern's own sign-in.
      export BMU_READER_USER="${BMU_QA_READER_USER:-}" BMU_READER_PASSWORD="${BMU_QA_READER_PASSWORD:-}"
      export BMU_ALWAYS_RUN_TIME="${BMU_ALWAYS_RUN_TIME:-false}" ;;
    test)
      # The Selenium tests' stack (bmut/README.md): the simulator on ports of its own, and every moment a run time, so
      # a submitted job runs at once. Its keys are made afresh each run (./bmu test), so it needs no .env.
      export BMU_UI_PORT=5573 BMU_API_PORT=8500 BMU_S3_PORT=9500 BMU_DYNAMODB_PORT=8501 BMU_SIM_PORT=8580
      export BMU_CSPACE_URL="http://fakecspace:8180" BMU_TENANT=pahma BMU_DEMO=true BMU_COOKIE_NAME=bmu_session_test
      export BMU_ENV_LABEL="Local · test stack"
      export BMU_READER_USER=bmureader BMU_READER_PASSWORD=bmureader
      export BMU_ALWAYS_RUN_TIME=true ;;
    *) echo "Unknown environment '$1': use sim or qa." >&2; exit 2 ;;
  esac
}
ui_port() { case "$1" in sim) echo 5173 ;; qa) echo 5273 ;; test) echo 5573 ;; esac; }

compose() {  # compose <env> <args...>
  local env="$1"; shift
  env_settings "$env"
  docker compose -p "bmu-$env" "$@"
}

open_url() {
  if command -v open >/dev/null 2>&1; then open "$1"
  elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$1" >/dev/null 2>&1 &
  else echo "$1"; fi
}

running() { [ -n "$(docker compose -p "bmu-$1" ps -q 2>/dev/null)" ]; }

# ---- commands ----------------------------------------------------------------------------------------------------
cmd="${1:-help}"; shift || true
case "$cmd" in
  up)
    env="${1:-sim}"
    env_settings "$env"
    [ -f .env ] || { echo "No .env yet: cp .env.example .env and put in the two keys (see README, Run it locally)." >&2; exit 1; }
    compose "$env" up -d --build
    port="$(ui_port "$env")"
    printf 'Waiting for http://localhost:%s ' "$port"
    for _ in $(seq 1 90); do
      if curl -fs -o /dev/null "http://localhost:$port/"; then echo; break; fi
      printf '.'; sleep 2
    done
    echo "$BMU_ENV_LABEL is up: http://localhost:$port   (./bmu open $env)"
    [ "$env" = qa ] && echo "Careful: jobs run here create real records in $QA_CSPACE_URL, and they stay."
    exit 0 ;;
  down)
    env="${1:-}"
    case "$env" in
      sim|qa) compose "$env" down ;;
      all) for e in sim qa; do running "$e" && compose "$e" down; done; true ;;
      *) echo "Usage: ./bmu down sim|qa|all" >&2; exit 2 ;;
    esac ;;
  status)
    for e in sim qa; do
      if running "$e"; then echo "$e: running  http://localhost:$(ui_port "$e")"; else echo "$e: stopped  (./bmu up $e)"; fi
    done
    if [ -n "$AWS_DEV_URL" ]; then echo "aws ($AWS_ENV): $AWS_DEV_URL   (./bmu aws status checks it)"; else echo "aws ($AWS_ENV): not deployed yet (./bmu aws deploy)"; fi ;;
  logs)
    env="${1:-sim}"; shift || true
    compose "$env" logs -f --tail 100 "$@" ;;
  open)
    case "${1:-home}" in
      sim|qa) open_url "http://localhost:$(ui_port "$1")" ;;
      aws) if [ -n "$AWS_DEV_URL" ]; then open_url "$AWS_DEV_URL"; else echo "The AWS environment '$AWS_ENV' isn't deployed from this computer yet (./bmu aws deploy)." >&2; exit 1; fi ;;
      mockup) open_url "$PWD/$MOCKUP_FILE" ;;
      home) open_url "$PWD/docs/start.html" ;;
      *) echo "Usage: ./bmu open sim|qa|aws|mockup|home" >&2; exit 2 ;;
    esac ;;
  urls)
    echo "UI mockup:              $PWD/$MOCKUP_FILE"
    echo "Local · simulator:      http://localhost:5173   (./bmu up sim)"
    echo "Local · QA ($QA_TENANT):   http://localhost:5273   (./bmu up qa)"
    printf "%-24s%s\n" "AWS ($AWS_ENV):" "${AWS_DEV_URL:-not deployed yet (./bmu aws deploy)}"
    echo "Start page:             $PWD/docs/start.html   (./bmu open home)" ;;
  aws)
    exec deploy/aws.sh "$@" ;;
  test)
    # Started afresh each run (every store is in memory), so every run begins from the same data; left running
    # afterwards, to look at what a failed test saw. bmut/README.md explains the suite.
    py="$(command -v python3.11 || true)"
    [ -n "$py" ] || { echo "./bmu test needs python3.11 (the repository's Python)." >&2; exit 1; }
    if [ ! -x bmut/.venv/bin/python ]; then
      "$py" -m venv bmut/.venv
      bmut/.venv/bin/pip install -q --require-hashes -r bmut/requirements.txt
    fi
    # Throwaway keys: the test stack holds only the simulator's synthetic accounts, and is never kept.
    BMU_SESSION_KEY_B64="$(openssl rand -base64 32)"; BMU_JOB_KEY_B64="$(openssl rand -base64 32)"
    export BMU_SESSION_KEY_B64 BMU_JOB_KEY_B64
    echo "Starting the test stack afresh"
    compose test down >/dev/null 2>&1 || true
    compose test up -d --build
    port="$(ui_port test)"
    printf 'Waiting for http://localhost:%s ' "$port"
    for _ in $(seq 1 120); do
      if curl -fs -o /dev/null "http://localhost:$port/api/env"; then echo; break; fi
      printf '.'; sleep 2
    done
    curl -fs -o /dev/null "http://localhost:$port/api/env" ||
      { echo; echo "Not up: docker compose -p bmu-test logs web frontend" >&2; exit 1; }
    rm -rf bmut/.run/failures
    status=0
    BMUT_STACK=test BMUT_BASE_URL="http://localhost:$port/" BMUT_SIM_URL="http://localhost:$BMU_SIM_PORT" \
      bmut/.venv/bin/python -m pytest bmut -p no:cacheprovider "$@" || status=$?
    echo "The test stack is still running (./bmu test-down stops it). Failed tests' screenshots: bmut/.run/failures/"
    exit "$status" ;;
  test-down)
    compose test down ;;
  help|-h|--help)
    sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "Unknown command '$cmd'. ./bmu help lists them." >&2; exit 2 ;;
esac
